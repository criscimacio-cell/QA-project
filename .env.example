# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://qtamp:qtamp_dev@localhost:5432/qtamp
POSTGRES_PASSWORD=qtamp_dev

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────
# REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-string-in-production
JWT_EXPIRES_IN=8h

# ── Platform admin (backoffice — full cross-tenant access) ────────────────
# Optional. If unset, a random password is generated on first boot and
# printed once to the server console (not recoverable afterwards). Set these
# to pin your own instead of relying on the generated one.
PLATFORM_ADMIN_EMAIL=platform@qlarity.com
PLATFORM_ADMIN_PASSWORD=

# ── Server ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
TRUST_PROXY=0

# ── File storage ──────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ── Backups ───────────────────────────────────────────────────────────────
# Nightly (2 AM) local backup: pg_dump + a zip of UPLOAD_DIR, written here
# and rotated automatically (daily copies for 7 days, then weekly for 4
# more weeks). Point this at a separate disk/volume from UPLOAD_DIR where
# possible — a backup on the same disk doesn't survive that disk failing.
BACKUP_DIR=./backups

# ── File encryption (AES-256-GCM at rest) ────────────────────────────────
# REQUIRED in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this, files are stored unencrypted (warning logged on startup).
FILE_ENCRYPTION_KEY=

# ── Docker (used by docker-compose) ───────────────────────────────────────
EXPOSE_PORT=80

# ── Resend Email (active provider) ────────────────────────────────────────
# Get a key at https://resend.com. Without a custom domain use onboarding@resend.dev
# (note: sandbox sender can only deliver to your own Resend account email).
RESEND_API_KEY=
EMAIL_FROM=Qlarity <onboarding@resend.dev>

# App URL (used in email links)
APP_URL=http://localhost:5173
