# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://qtamp:qtamp_dev@localhost:5432/qtamp
POSTGRES_PASSWORD=qtamp_dev

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────
# REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-string-in-production
JWT_EXPIRES_IN=8h

# ── Server ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
TRUST_PROXY=0

# ── File storage ──────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ── Docker (used by docker-compose) ───────────────────────────────────────
EXPOSE_PORT=80

# ── SMTP Email (optional) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Qlarity <noreply@yourcompany.com>
APP_URL=http://localhost:5173
