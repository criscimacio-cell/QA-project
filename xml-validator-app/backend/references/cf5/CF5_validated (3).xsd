<?xml version="1.0" encoding="UTF-8"?>
<!--
  XSD Schema: CF5 eClaims (DRG Claim)
  Source DTD : CF5.dtd (PhilHealth)
  Enhanced   : Annex E Data Dictionary validateCF5
  Notes      : Structurally equivalent to the DTD, enriched with
               data types, length constraints, regex patterns,
               enumerations, and Oracle-style CHECK equivalents
               via xs:restriction.

  Oracle Validation Mapping:
    DTD #REQUIRED         = use="required"
    Oracle VARCHAR2(n)    = xs:maxLength n
    Oracle CHECK pattern  = xs:pattern
    Oracle CHECK IN list  = xs:enumeration
    Oracle NUMBER(p,s)    = xs:pattern for format control
    Oracle NOT NULL       = use="required"
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           version="1.0">

  <!-- ROOT ELEMENT: CF5
       Annex E: pHospitalCode = Varchar(6)
       Format: 999999 or X99999
       Oracle: pHospitalCode VARCHAR2(6) NOT NULL
               CHECK (REGEXP_LIKE(pHospitalCode,'^[0-9]{6}$|^X[0-9]{5}$'))
  -->
  <xs:element name="CF5">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="DRGCLAIM" minOccurs="1" maxOccurs="1"/>
      </xs:sequence>
      <xs:attribute name="pHospitalCode" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="6"/>
            <xs:maxLength value="6"/>
            <xs:pattern value="[0-9]{6}|X[0-9]{5}"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>


  <!-- ELEMENT: DRGCLAIM
       Annex E fields:
         ClaimNumber      = Varchar(13), format 9999999999999
         PrimaryCode      = Varchar(15), valid ICD-10
         NewBornAdmWeight = Numeric(2,1), REQUIRED field (attribute must be
                             present), value left BLANK when not a newborn
                             case; when value is provided: greater than 0.3
                             up to 6.0, format ##.#
         Remarks          = Varchar(2000)

       Oracle:
         ClaimNumber VARCHAR2(13) NOT NULL
           CHECK (REGEXP_LIKE(ClaimNumber,'^[0-9]{13}$'))
         PrimaryCode VARCHAR2(15) NOT NULL
           CHECK (REGEXP_LIKE(PrimaryCode,'^[A-Z][0-9]{2}(\.[A-Z0-9]{1,4})?$'))
         NewBornAdmWeight VARCHAR2(4) NOT NULL  (column required, may be blank)
           CHECK (val = '' OR
                  (REGEXP_LIKE(val,'^[0-9]{1,2}\.[0-9]$') AND val > 0.3 AND val <= 6.0))
         Remarks VARCHAR2(2000) NOT NULL
  -->
  <xs:element name="DRGCLAIM">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="SECONDARYDIAGS" minOccurs="1" maxOccurs="1"/>
        <xs:element ref="PROCEDURES"     minOccurs="1" maxOccurs="1"/>
      </xs:sequence>

      <xs:attribute name="ClaimNumber" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="13"/>
            <xs:maxLength value="13"/>
            <xs:pattern value="[0-9]{13}"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>

      <xs:attribute name="PrimaryCode" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="3"/>
            <xs:maxLength value="15"/>
            <xs:pattern value="[A-Z][0-9]{2}(\.[A-Z0-9]{1,4})?"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>

      <xs:attribute name="NewBornAdmWeight" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="([0-9]{1,2}\.[0-9])?"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>

      <xs:attribute name="Remarks" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="2000"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>

    </xs:complexType>
  </xs:element>


  <!-- ELEMENT: SECONDARYDIAGS
       Container for secondary diagnosis codes.
       Annex E: Up to 12 secondary diagnoses per claim.
       Oracle: max 12 rows in SECONDARYDIAG per ClaimNumber
  -->
  <xs:element name="SECONDARYDIAGS">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="SECONDARYDIAG" minOccurs="0" maxOccurs="12"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>


  <!-- ELEMENT: SECONDARYDIAG
       Annex E fields:
         SecondaryCode = Varchar(15), valid ICD-10
         Remarks       = Varchar(2000)

       Oracle:
         SecondaryCode VARCHAR2(15) NOT NULL
           CHECK (REGEXP_LIKE(SecondaryCode,'^[A-Z][0-9]{2}(\.[A-Z0-9]{1,4})?$'))
         Remarks VARCHAR2(2000) NOT NULL
  -->
  <xs:element name="SECONDARYDIAG">
    <xs:complexType>

      <xs:attribute name="SecondaryCode" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="3"/>
            <xs:maxLength value="15"/>
            <xs:pattern value="[A-Z][0-9]{2}(\.[A-Z0-9]{1,4})?"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>

      <xs:attribute name="Remarks" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="2000"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>

    </xs:complexType>
  </xs:element>


  <!-- ELEMENT: PROCEDURES
       Container for procedure codes.
       Annex E: Up to 20 procedures per claim.
       Oracle: max 20 rows in PROCEDURE per ClaimNumber
  -->
  <xs:element name="PROCEDURES">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="PROCEDURE" minOccurs="0" maxOccurs="20"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>


  <!-- ELEMENT: PROCEDURE
       Annex E fields:
         RvsCode    = Varchar(6),  valid RVS code
         Laterality = Varchar(1),  L=Left R=Right B=Both N=None
         Ext1       = Numeric(1),  1-9, number of body sites
         Ext2       = Numeric(1),  1-9, number of times procedure done
         Remarks    = Varchar(2000)

       Oracle:
         RvsCode VARCHAR2(6) NOT NULL
         Laterality VARCHAR2(1) NOT NULL
           CHECK (Laterality IN ('L','R','B','N'))
         Ext1 NUMBER(1) NOT NULL CHECK (Ext1 BETWEEN 1 AND 9)
         Ext2 NUMBER(1) NOT NULL CHECK (Ext2 BETWEEN 1 AND 9)
         Remarks VARCHAR2(2000) NOT NULL
  -->
  <xs:element name="PROCEDURE">
    <xs:complexType>

      <xs:attribute name="RvsCode" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="6"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>

      <xs:attribute name="Laterality" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="L"/>
            <xs:enumeration value="R"/>
            <xs:enumeration value="B"/>
            <xs:enumeration value="N"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>

      <xs:attribute name="Ext1" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[1-9]"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>

      <xs:attribute name="Ext2" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[1-9]"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>

      <xs:attribute name="Remarks" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="2000"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>

    </xs:complexType>
  </xs:element>

</xs:schema>
